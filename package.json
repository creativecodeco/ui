{
  "name": "@creativecodeco/ui",
  "description": "React 19 UI component library & Design System built with TypeScript, Tailwind CSS v4, and DaisyUI v5 by CreativeCode.",
  "keywords": [
    "creativecode",
    "creativecodeco",
    "react",
    "react19",
    "typescript",
    "tailwindcss",
    "daisyui",
    "design-system",
    "component-library",
    "react-components",
    "react-hook-form",
    "storybook"
  ],
  "version": "2.7.0",
  "homepage": "https://github.com/creativecodeco/ui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/creativecodeco/ui.git"
  },
  "bugs": {
    "url": "https://github.com/creativecodeco/ui/issues"
  },
  "author": {
    "name": "John Toro",
    "email": "joaltoroc@creativecode.com.co"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.22.1",
    "npm": ">=12.2.1"
  },
  "packageManager": "npm@12.2.1",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "source": "src/index.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./theme/main.css": "./lib/theme/main.css",
    "./theme/css/*": "./lib/theme/css/*",
    "./lib/*": "./lib/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "npm run build; npm run storybook",
    "dev:css": "postcss src/theme/main.css -o lib/theme/main.css --watch",
    "build": "rm -rf lib; tsc -p tsconfig.build.json; npm run build:alias; npm run build:css",
    "build:alias": "tsc-alias -p tsconfig.build.json",
    "build:css": "postcss src/theme/main.css -o lib/theme/main.css --minify; cpx 'src/theme/*[.]css' 'lib/theme/css'",
    "build-storybook": "npm run build; storybook build",
    "chromatic": "chromatic --only-changed true",
    "lint": "npm run lint:eslint",
    "lint:eslint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "npm run build",
    "prepare": "husky",
    "release": "npm publish --access public",
    "storybook": "storybook dev -p 6006",
    "test": "jest .",
    "test:action": "jest --coverage | tee ./coverage.txt && jest --ci --reporters=default --reporters=jest-junit",
    "test:update": "jest --updateSnapshot",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "postcss": "8.5.32",
    "react": "19.3.1",
    "react-hook-form": "7.91.0",
    "tailwindcss": "4.3.3",
    "usehooks-ts": "3.1.1"
  },
  "dependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "postcss": "8.5.32",
    "react": "19.3.1",
    "react-hook-form": "7.91.0",
    "tailwindcss": "4.3.3",
    "usehooks-ts": "3.1.1"
  },
  "devDependencies": {
    "@babel/core": "8.0.9",
    "@babel/preset-env": "8.0.7",
    "@babel/preset-react": "8.0.1",
    "@babel/preset-typescript": "8.0.7",
    "@chromatic-com/storybook": "5.6.0",
    "@eslint/js": "10.0.1",
    "@jest/globals": "30.5.2",
    "@storybook/addon-docs": "10.6.4",
    "@storybook/addon-links": "10.6.4",
    "@storybook/addon-webpack5-compiler-swc": "4.0.3",
    "@storybook/react-webpack5": "10.6.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "chromatic": "18.13.3",
    "classnames": "2.5.1",
    "cpx2": "9.0.3",
    "daisyui": "5.7.50",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-storybook": "10.6.4",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "jest-junit": "17.0.0",
    "jest-transform-css": "6.0.3",
    "postcss-cli": "12.0.0",
    "prettier": "3.9.10",
    "prop-types": "15.8.1",
    "react-dom": "19.3.1",
    "react-icons": "5.7.0",
    "storybook": "10.6.4",
    "string-width": "8.3.0",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "tsc-alias": "1.9.9",
    "tsconfig-paths-webpack-plugin": "4.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "files": [
    "lib"
  ],
  "overrides": {
    "braces": "npm:brace-expansion@^2.1.7",
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "flat-cache": "^4.0.1",
    "glob": "^13.0.6",
    "js-yaml": "^4.1.1",
    "jsdom": "^29.1.1",
    "tsc-alias": {
      "chokidar": "^4.0.3"
    },
    "webpack-dev-middleware": "^7.4.5"
  }
}
