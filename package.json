{
  "name": "@creativecodeco/ui",
  "description": "System Design CreativeCode.com.co",
  "keywords": [
    "creativeCode.com.co",
    "creativecodeco/ui",
    "tailwindcss",
    "daisyui",
    "ui",
    "framework design",
    "design system"
  ],
  "version": "2.6.1",
  "homepage": "https://github.com/creativecodeco/ui",
  "author": {
    "name": "John Toro",
    "email": "joaltoroc@creativecode.com.co"
  },
  "license": "MIT",
  "main": "lib/index.js",
  "source": "src/index.ts",
  "scripts": {
    "dev": "npm run build; npm run storybook",
    "dev:css": "postcss src/theme/main.css -o lib/theme/main.css --watch",
    "build": "rm -rf lib; tsc -p tsconfig.build.json; npm run build:alias; npm run build:css",
    "build:alias": "tsc-alias -p tsconfig.build.json",
    "build:css": "postcss src/theme/main.css -o lib/theme/main.css --minify; cpx 'src/theme/*[.]css' 'lib/theme/css'",
    "build-storybook": "npm run build; storybook build",
    "chromatic": "chromatic --only-changed true",
    "lint": "npm run lint:eslint",
    "lint:eslint": "eslint .",
    "lint:fix": "npm run lint:eslint --quiet",
    "prepack": "npm run build",
    "prepare": "husky",
    "release": "npm publish --access public",
    "storybook": "storybook dev -p 6006",
    "test": "jest .",
    "test:action": "jest --coverage | tee ./coverage.txt && jest --ci --reporters=default --reporters=jest-junit",
    "test:update": "jest --updateSnapshot",
    "test:watch": "jest --watch"
  },
  "peerDependencies": {
    "@tailwindcss/postcss": "4.1.18",
    "postcss": "8.5.6",
    "react": "19.2.8",
    "react-hook-form": "7.58.1",
    "tailwindcss": "4.1.18",
    "usehooks-ts": "3.1.1"
  },
  "dependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "postcss": "8.5.28",
    "react": "19.3.0",
    "react-hook-form": "7.89.0",
    "tailwindcss": "4.3.3",
    "usehooks-ts": "3.1.1"
  },
  "devDependencies": {
    "@babel/core": "8.0.6",
    "@babel/preset-env": "8.0.6",
    "@babel/preset-react": "8.0.1",
    "@babel/preset-typescript": "8.0.1",
    "@chromatic-com/storybook": "5.3.1",
    "@eslint/js": "9.39.5",
    "@jest/globals": "30.5.2",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/addon-links": "10.6.1",
    "@storybook/addon-webpack5-compiler-swc": "4.0.3",
    "@storybook/react-webpack5": "10.6.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "chromatic": "18.10.1",
    "classnames": "2.5.1",
    "cpx2": "9.0.3",
    "daisyui": "5.7.47",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-storybook": "10.6.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "jest-junit": "17.0.0",
    "jest-transform-css": "6.0.3",
    "postcss-cli": "12.0.0",
    "prettier": "3.9.9",
    "prop-types": "15.8.1",
    "react-dom": "19.3.0",
    "react-icons": "5.7.0",
    "storybook": "10.6.1",
    "string-width": "8.3.0",
    "ts-jest": "29.4.14",
    "ts-node": "10.9.2",
    "tsc-alias": "1.9.5",
    "tsconfig-paths-webpack-plugin": "4.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  },
  "files": [
    "lib"
  ],
  "overrides": {
    "webpack-dev-middleware": "^7.4.5"
  }
}
